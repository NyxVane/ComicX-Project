<Window x:Class="ComicX.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicX Management System" Height="600" Width="550" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">

        <!-- BEJELENTKEZÉS PANEL -->
        <StackPanel x:Name="pnlLogin" VerticalAlignment="Center" Width="300">
            <TextBlock Text="ComicX System Login" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" TextAlignment="Center"/>

            <TextBlock Text="Username:"/>
            <TextBox x:Name="txtUsername" Height="25" Margin="0,5,0,10"/>

            <TextBlock Text="Password:"/>
            <PasswordBox x:Name="txtPassword" Height="25" Margin="0,5,0,15"/>

            <Button x:Name="btnLogin" Content="Login" Height="30" Click="BtnLogin_Click"/>
        </StackPanel>

        <!-- FŐMENÜ PANEL (Kezdetben rejtett) -->
        <StackPanel x:Name="pnlMenu" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="****** Here are your options ******" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Logout" Width="70" Height="25" HorizontalAlignment="Right" Background="#D9534F" Foreground="White" FontWeight="Bold" Click="BtnLogout_Click"/>
            </DockPanel>

            <TextBlock Text="Please select the action." Margin="0,0,0,10" FontStyle="Italic"/>

            <Button Content="1. Show stock count for each theme of books" Height="30" Margin="0,3" Click="BtnStock_Click"/>
            <Button Content="2. Show total value of each theme type for all comic books in stock" Height="30" Margin="0,3" Click="BtnValues_Click"/>
            <!-- ELADÁS RÉSZLEG -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="3. Register comic books sold" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Enter theme (Batman, Joker, Cat, TheRiddler, Pinguin):" FontSize="11"/>
                    <TextBox x:Name="txtThemeInput" Height="25" Margin="0,3,0,5"/>

                    <TextBlock Text="Enter quantity:" FontSize="11"/>
                    <TextBox x:Name="txtQuantityInput" Height="25" Margin="0,3,0,10" Text="1"/>

                    <Button Content="Register Sale" Height="28" Click="BtnSell_Click"/>
                </StackPanel>
            </Border>
            <Button Content="4. Get stock status" Height="30" Margin="0,3" Click="BtnStatus_Click"/>

            <!-- Eredmények megjelenítésére szolgáló doboz -->
            <TextBox x:Name="txtOutput" IsReadOnly="True" Height="100" Margin="0,15,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

    </Grid>
</Window>